*.tmp
*.temp
*.log

# Composer (if using)
# vendor/
# composer.lock

# Node Modules (if using)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup Files
*.bak
*.backup
*.old

# Configuration Files with Sensitive Data
config/database.php
config/config.php

# =============================================================================
# Environment files — contain real credentials, NEVER commit these
# =============================================================================
env.local
env.live
env.development
env.testing
env.staging
.env
.env.*

# Commit ONLY the safe example template:
!env.example

