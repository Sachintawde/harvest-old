# Environment Configuration File
# Copy this file to .env.{environment} for your specific environment
# Example: .env.local, .env.development, .env.production, .env.live

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_DRIVER=mysqli
DB_PREFIX=
DB_DEBUG=true
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Harvest Green
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
ENCRYPTION_KEY=your_32_character_encryption_key_here
SESSION_SECURE=false
COOKIE_SECURE=false

# =============================================================================
# MAIL / SMTP CONFIGURATION (Microsoft Outlook — single provider)
# =============================================================================
# Copy real values into env.local (local) or env.live (production).
# NEVER put real credentials in this file — it is safe to commit.
#
# Email is sent via Microsoft Graph API (OAuth 2.0 client credentials).
# Register an App in Azure AD, grant Mail.Send (Application), and grant admin consent.
#
# Required env vars:
#   MS_GRAPH_TENANT_ID     = Azure AD Tenant (Directory) ID
#   MS_GRAPH_CLIENT_ID     = App (Application) ID
#   MS_GRAPH_CLIENT_SECRET = Client Secret value (not the secret ID)
#   MAIL_FROM_ADDRESS      = The licensed mailbox to send FROM (must have Mail.Send)
#
# Optional / informational:
#   MAIL_FROM_NAME         = Display name shown in From header
#   ADMIN_MAIL_TO          = Address that receives admin/form-submission copies
# =============================================================================

# Microsoft Graph API credentials
MS_GRAPH_TENANT_ID=your-azure-tenant-id
MS_GRAPH_CLIENT_ID=your-azure-app-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-client-secret

# Sender mailbox (must be a licensed O365/Exchange mailbox)
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Your App Name

# Admin notification recipient (receives tour/form submission emails)
ADMIN_MAIL_TO=admin@yourdomain.com

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_DRIVER=file
CACHE_PREFIX=harvest_
CACHE_TTL=3600

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=debug
LOG_CHANNEL=stack

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# =============================================================================
# CUSTOM CONFIGURATIONS
# =============================================================================
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
MAINTENANCE_MODE=false
