# Environment Configuration File
# Copy this file to .env.{environment} for your specific environment
# Example: .env.local, .env.development, .env.production, .env.live

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_DRIVER=mysqli
DB_PREFIX=
DB_DEBUG=true
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=Harvest Green
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
ENCRYPTION_KEY=your_32_character_encryption_key_here
SESSION_SECURE=false
COOKIE_SECURE=false

# =============================================================================
# MAIL / SMTP CONFIGURATION (Microsoft Outlook — single provider)
# =============================================================================
# Copy real values into env.local (local) or env.live (production).
# NEVER put real credentials in this file — it is safe to commit.
#
# Microsoft Outlook / Office 365 SMTP settings:
#   MAIL_HOST       = smtp.office365.com
#   MAIL_PORT       = 587
#   MAIL_ENCRYPTION = tls
#   MAIL_USERNAME   = your_outlook_email@yourdomain.com
#   MAIL_PASSWORD   = your_outlook_password_or_app_password
#
# All email channels (admin notifications, applicant confirmations, etc.)
# route through this single SMTP configuration.
# =============================================================================
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_outlook_password_or_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Your App Name

# Admin notification recipient (receives tour/form submission emails)
ADMIN_MAIL_TO=admin@yourdomain.com

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_DRIVER=file
CACHE_PREFIX=harvest_
CACHE_TTL=3600

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=debug
LOG_CHANNEL=stack

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# =============================================================================
# CUSTOM CONFIGURATIONS
# =============================================================================
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
MAINTENANCE_MODE=false
